# Port to listen on
PORT=8787

# Comma-separated list of builtin plugin ids to enable. Omit to enable all builtin plugins.
# ENABLED_PLUGINS=salvation-army

# Comma-separated list of external plugin module paths/specifiers to load in addition to
# builtins. Each module's default (or named `plugin`) export must implement ReceiptPlugin.
# Only point this at code you trust -- plugins run as trusted server-side code.
# EXTERNAL_PLUGINS=/path/to/my-charity-plugin.js
